---
const milestones = [
  { year: '2004', title: 'Hiweed Linux 0.3', desc: 'Cikal bakal deepin — distribusi Linux pertama berbasis Debian dengan dukungan bahasa Tiongkok.' },
  { year: '2008', title: 'deepin Community', desc: 'Komunitas deepin resmi didirikan. Setahun kemudian berganti nama jadi Linux deepin dan merilis versi 9.12.' },
  { year: '2013', title: 'DDE 1.0 & Linux deepin 12.12', desc: 'Deepin Desktop Environment pertama dirilis. App Store pertama di Tiongkok dengan 800+ aplikasi.' },
  { year: '2015', title: 'deepin 15 — Top 10 Global', desc: 'Arsitektur baru deepin 15, bergabung dengan Linux Foundation. Masuk 10 besar distro Linux dunia.' },
  { year: '2020', title: 'deepin 20 & Linyaps', desc: 'Dual kernel, DDE 5.0 dengan KWin. Prototipe Linyaps — format paket generasi baru.' },
  { year: '2023', title: 'UOS AI & deepin IDE', desc: 'Sistem operasi open source pertama yang mengintegrasikan AI. deepin IDE dan Campus Alliance diluncurkan.' },
  { year: '2024', title: 'deepin 23 & Root Community', desc: 'Root community mandiri, Treeland Wayland compositor, Linyaps, Atomic Updates, 100.000+ aplikasi.' },
];
---

<section class="py-20 bg-white">
  <div class="container-main">
    <div class="text-center mb-14">
      <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-deepin-50 text-deepin-700 text-xs font-semibold tracking-wide uppercase mb-4">
        <i class="fas fa-clock-rotate-left text-[10px]"></i> Perjalanan
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-gray-900">
        Dari <span class="text-deepin-600">Hiweed ke deepin</span>
      </h2>
      <p class="mt-3 text-gray-500 max-w-2xl mx-auto">
        Perjalanan lebih dari dua dekade menciptakan sistem operasi yang digemari jutaan pengguna di seluruh dunia.
      </p>
    </div>

    <div class="relative max-w-3xl mx-auto">
      <!-- Line -->
      <div class="absolute left-[19px] sm:left-1/2 top-0 bottom-0 w-0.5 bg-deepin-200 sm:-translate-x-px" />

      {milestones.map((m, i) => (
        <div class={`relative flex items-start gap-6 mb-10 ${i % 2 === 0 ? 'sm:flex-row' : 'sm:flex-row-reverse'}`}>
          {/* Dot */}
          <div class="absolute left-0 sm:left-1/2 w-[38px] h-[38px] rounded-full bg-deepin-600 border-4 border-white shadow-md -translate-x-1/2 z-10 flex items-center justify-center">
            <span class="text-[10px] font-bold text-white">{m.year.slice(2)}</span>
          </div>

          {/* Card */}
          <div class={`ml-12 sm:ml-0 sm:w-[calc(50%-30px)] ${i % 2 === 0 ? 'sm:pr-10 sm:text-right' : 'sm:pl-10'}`}>
            <div class="card p-5">
              <span class="text-xs font-bold text-deepin-600 tracking-wide">{m.year}</span>
              <h3 class="font-bold text-gray-900 mt-1">{m.title}</h3>
              <p class="text-sm text-gray-500 mt-1.5 leading-relaxed">{m.desc}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
