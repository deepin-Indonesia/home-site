---
const stats = [
  { value: '7,6Jt+', label: 'Pengguna Komunitas', icon: 'fa-users' },
  { value: '80Jt+', label: 'Total Download Global', icon: 'fa-download' },
  { value: '25Jt+', label: 'Baris Kode Open Source', icon: 'fa-code' },
  { value: '20Jt+', label: 'Baris Kode In-House', icon: 'fa-cubes' },
  { value: '3Jt+', label: 'Pengguna Luar Negeri', icon: 'fa-globe' },
  { value: '60+', label: 'Versi Telah Dirilis', icon: 'fa-rocket' },
  { value: '11Rb+', label: 'Issues', icon: 'fa-bug' },
  { value: '24Rb+', label: 'Pull Requests', icon: 'fa-code-pull-request' },
];
---

<section class="py-16 bg-deepin-600 relative overflow-hidden">
  <!-- BG gradient orbs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -right-40 w-80 h-80 bg-deepin-500 rounded-full opacity-30 blur-3xl" />
    <div class="absolute -bottom-40 -left-40 w-80 h-80 bg-deepin-800 rounded-full opacity-30 blur-3xl" />
  </div>

  <div class="container-main relative">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
        deepin dalam <span class="text-deepin-200">Angka</span>
      </h2>
      <p class="mt-2 text-deepin-300 text-sm">Salah satu komunitas OS desktop paling aktif di dunia</p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      {stats.map((s) => (
        <div class="bg-white/10 backdrop-blur rounded-2xl p-5 text-center hover:bg-white/15 transition-colors">
          <i class={`fas ${s.icon} text-2xl text-deepin-200 mb-3`} />
          <div class="text-2xl sm:text-3xl font-extrabold text-white mb-1">{s.value}</div>
          <div class="text-xs text-deepin-200 leading-snug">{s.label}</div>
        </div>
      ))}
    </div>

    <p class="text-center text-xs text-deepin-400/60 mt-6 italic">Data per Oktober 2024</p>
  </div>
</section>
